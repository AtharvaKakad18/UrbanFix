# UrbanFix Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database
# For local dev: mongodb://127.0.0.1:27017/urbanfix
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbanfix?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/urbanfix

# JWT Authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated list for multi-domains/previews)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# xAI Grok API Configuration (Backend Only)
XAI_API_KEY=your_xai_grok_api_key_here
GROK_VISION_MODEL=grok-4.7
GROK_VISION_FALLBACK_MODEL=grok-4.3
GROK_TEXT_MODEL=grok-4.7
AI_MIN_CONFIDENCE=0.6

# Cloudinary Media Storage (Photos only)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Geocoder Proxy Configuration
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=UrbanFix-Platform/1.0 (urbanfix@civictech.local)

# Business Rules Engine Parameters
DUPLICATE_RADIUS_METERS=40
AUTO_CLOSE_DAYS=3
